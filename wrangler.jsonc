// Cloudflare Worker serving this folder as a static site, plus the contact form (worker.js).
// Set in the dashboard (Settings → Variables and secrets): CONTACT_TO (text) and TURNSTILE_SECRET (secret).
{
  "name": "brightpath-online",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Unknown URLs get 404.html instead of Cloudflare's blank 404.
    "not_found_handling": "404-page",
    // Only the form endpoint runs code; every other request is a plain file.
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["contact@brightpath-solutions.online"] }
  ]
}
